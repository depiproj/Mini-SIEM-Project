# ── Database (default: SQLite) ────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./siem.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:pass@localhost/siem

# ── IOC Enrichment API Keys (optional — system works without them) ─────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# ── ML Engine ─────────────────────────────────────────────────────────────────
ML_ENABLED=true
ML_MODEL_PATH=ml_engine/security_rf_model.pkl

# ── Email Alerts (optional) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_RECIPIENTS=soc-team@company.com

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
